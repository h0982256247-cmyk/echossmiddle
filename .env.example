# ── Rezio API ──────────────────────────────────────────────────
REZIO_STORE_UUID=your_store_uuid
REZIO_API_KEY=your_api_key
REZIO_LANG=zh-TW

# ── Echoss API ─────────────────────────────────────────────────
ECHOSS_API_URL=https://your-echoss-domain.com
ECHOSS_API_TOKEN=your_bearer_token

# ── Supabase ───────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# ── Gmail OAuth2（寄信用）──────────────────────────────────────
# 取得方式：Google Cloud Console → OAuth 2.0 憑證
GMAIL_USER=your@gmail.com
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token

# 週報收件人（農遊信箱）
REPORT_TO=recipient@email.com

# ── 安全驗證 ───────────────────────────────────────────────────
# Supabase pg_cron 觸發 /api/run 時帶的 Bearer token
CRON_SECRET=your_random_secret_string_at_least_32_chars

# ── 後台登入 ───────────────────────────────────────────────────
# 後台管理介面的登入密碼，不設定則無需密碼
ADMIN_PASSWORD=your_admin_password

# ── 測試模式 ───────────────────────────────────────────────────
# 設為 true 時，所有信件（含消費者通知）都改寄到 REPORT_TO，不寄給消費者
# 測試完畢後移除或改為 false
TEST_MODE=false
